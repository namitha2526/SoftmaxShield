# SoftmaxShield Environment Configuration Template
# Copy to .env and customize values for local development and production.

# Optional LLM API Keys (used for live model generation & real self-correction)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
HUGGINGFACE_TOKEN=your_huggingface_token_here

# SoftmaxShield Verification Settings
SOFTMAXSHIELD_OFFLINE_MODE=false
SOFTMAXSHIELD_STRICT_MODE=false
PYPI_API_TIMEOUT=5.0
MAX_CORRECTION_ROUNDS=3
CONFIDENCE_THRESHOLD=0.85
TYPOSQUAT_DISTANCE_THRESHOLD=2
TYPOSQUAT_SIMILARITY_THRESHOLD=0.80

# API & Service Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Logging & Cache Settings
LOG_LEVEL=INFO
MPLCONFIGDIR=/tmp/matplotlib_cache

